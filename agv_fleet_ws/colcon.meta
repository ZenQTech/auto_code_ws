{
  "names": {
    "agv_msgs": {
      "cmake-args": ["-DCMAKE_BUILD_TYPE=Release"]
    },
    "agv_core": {
      "cmake-args": ["-DCMAKE_BUILD_TYPE=Release"]
    },
    "agv_safety": {
      "cmake-args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CXX_FLAGS=-Werror -Wall -Wextra"
      ]
    }
  }
}
