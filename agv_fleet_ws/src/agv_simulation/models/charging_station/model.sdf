<?xml version="1.0"?>
<!--
  Charging Station Model
  Dimensions: 1.0m x 0.5m x 0.3m
-->
<sdf version="1.8">
<model name="charging_station">
  <static>true</static>
  <link name="link">
    <pose>0 0 0.15 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>1.0 0.5 0.3</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>1.0 0.5 0.3</size></box></geometry>
      <material>
        <ambient>0.0 0.5 0.0 1.0</ambient>
        <diffuse>0.0 0.5 0.0 1.0</diffuse>
      </material>
    </visual>
  </link>
  <!-- Charging contact point marker -->
  <link name="contact_marker">
    <pose>0.5 0 0.15 0 0 0</pose>
    <visual name="visual">
      <geometry><box><size>0.05 0.2 0.05</size></box></geometry>
      <material>
        <ambient>0.0 1.0 0.0 1.0</ambient>
        <diffuse>0.0 1.0 0.0 1.0</diffuse>
      </material>
    </visual>
  </link>
  <joint name="marker_joint" type="fixed">
    <parent>link</parent>
    <child>contact_marker</child>
  </joint>
</model>
</sdf>
