<?xml version="1.0"?>
<!--
  Warehouse Shelf Model
  Dimensions: 1.2m x 1.0m x 1.8m
-->
<sdf version="1.8">
<model name="shelf">
  <static>true</static>
  <link name="shelf_link">
    <pose>0 0 0.9 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>1.2 1.0 1.8</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>1.2 1.0 1.8</size></box></geometry>
      <material>
        <ambient>0.5 0.35 0.2 1.0</ambient>
        <diffuse>0.5 0.35 0.2 1.0</diffuse>
      </material>
    </visual>
  </link>
</model>
</sdf>
