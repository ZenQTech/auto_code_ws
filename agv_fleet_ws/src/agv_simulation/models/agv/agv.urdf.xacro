<?xml version="1.0"?>
<!--
  AGV Differential Drive Model - URDF/Xacro
  Dimensions: 800 x 600 x 300 mm
  Max Speed: 1.5 m/s
  Payload: 500 kg
-->
<robot name="agv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================ -->
  <!-- Material definitions                         -->
  <!-- ============================================ -->
  <material name="agv_body_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="agv_accent_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.0 0.3 0.8 1.0"/>
  </material>
  <material name="safety_yellow">
    <color rgba="1.0 0.8 0.0 1.0"/>
  </material>

  <!-- ============================================ -->
  <!-- Macros                                       -->
  <!-- ============================================ -->

  <!-- Drive wheel macro -->
  <xacro:macro name="drive_wheel" params="name prefix x_reflect">
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${x_reflect * 0.25} ${0.25 * (1 if prefix == 'right' else -1)} -0.1" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.06"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.06"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Caster wheel macro -->
  <xacro:macro name="caster_wheel" params="name x y">
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} -0.12" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
    </joint>
    <link name="${name}_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ============================================ -->
  <!-- Base link (chassis)                          -->
  <!-- ============================================ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="80.0"/>
      <inertia
        ixx="${80.0 * (0.6*0.6 + 0.3*0.3) / 12}"
        ixy="0.0" ixz="0.0"
        iyy="${80.0 * (0.8*0.8 + 0.3*0.3) / 12}"
        iyz="0.0"
        izz="${80.0 * (0.8*0.8 + 0.6*0.6) / 12}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
      <material name="agv_body_grey"/>
    </visual>
    <visual>
      <!-- Orange accent stripe -->
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.1 0.02"/>
      </geometry>
      <material name="agv_accent_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================ -->
  <!-- Drive wheels                                 -->
  <!-- ============================================ -->
  <xacro:drive_wheel name="left_wheel" prefix="left" x_reflect="-1"/>
  <xacro:drive_wheel name="right_wheel" prefix="right" x_reflect="-1"/>

  <!-- ============================================ -->
  <!-- Caster wheels (support)                      -->
  <!-- ============================================ -->
  <xacro:caster_wheel name="front_caster" x="0.35" y="0"/>
  <xacro:caster_wheel name="rear_left_caster" x="-0.35" y="-0.25"/>
  <xacro:caster_wheel name="rear_right_caster" x="-0.35" y="0.25"/>

  <!-- ============================================ -->
  <!-- Sensors                                      -->
  <!-- ============================================ -->

  <!-- 3D LiDAR (top mounted) -->
  <link name="lidar_link">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.1"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.1"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Front RGB-D camera -->
  <link name="camera_front_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="camera_front_joint" type="fixed">
    <origin xyz="0.38 0 0.25" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_front_link"/>
  </joint>

  <!-- Rear RGB-D camera -->
  <link name="camera_rear_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="camera_rear_joint" type="fixed">
    <origin xyz="-0.38 0 0.25" rpy="0 3.14159 0"/>
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
  </joint>

  <!-- IMU (center, inside chassis) -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Safety edge visual (yellow stripe around base) -->
  <link name="safety_edge_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.82 0.62 0.02"/>
      </geometry>
      <material name="safety_yellow"/>
    </visual>
  </link>
  <joint name="safety_edge_joint" type="fixed">
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="safety_edge_link"/>
  </joint>

  <!-- ============================================ -->
  <!-- Gazebo extensions                            -->
  <!-- ============================================ -->
  <gazebo>
    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- Wheel configuration -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- Odometry -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <!-- Topic configuration -->
      <ros>
        <namespace>/agv_01</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <!-- Update rate -->
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

  <!-- LiDAR sensor plugin -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0.05 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/agv_01</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU sensor plugin -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/agv_01</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Safety bumper/contact sensor -->
  <gazebo reference="safety_edge_link">
    <sensor name="bumper_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <collision>base_link</collision>
      </contact>
      <plugin name="gazebo_ros_bumper" filename="libgazebo_ros_bumper.so">
        <ros>
          <namespace>/agv_01</namespace>
          <remapping>~/out:=safety/bumper</remapping>
        </ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
