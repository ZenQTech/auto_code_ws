# 导航到目标点（含进度反馈）
geometry_msgs/PoseStamped target_pose
float32 speed_override            # 速度覆盖（0=使用默认值）
---
float32 distance_remaining        # 剩余距离 (m)
float32 eta                       # 预计到达时间 (s)
geometry_msgs/Pose current_pose   # 当前位置
---
bool reached                      # 是否到达
string message
