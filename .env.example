# ============================================================
# Claude Code 调度平台 - 环境变量样例
# ============================================================
# 核心作用：列出 docker-compose 启动所必需的环境变量，
#          复制此文件为 .env 后填入实际值
# 运行流程：
#   1. cp .env.example .env
#   2. 编辑 .env，填入真实凭据
#   3. docker-compose up -d
# 输入参数：所有变量通过 docker-compose 注入到容器
# 输出结果：可运行的容器栈
# 修改记录：
#   - 2026-07-24 | v1.0.0 | Module F2 - 基础设施升级：环境变量样例
# ============================================================

# ============================================================
# 数据库连接（Module F1 PostgreSQL 支持）
# ============================================================
# 默认连接 docker-compose 内的 postgres 服务
# 生产环境请改为托管 PostgreSQL 连接串
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/claude_code

# ============================================================
# Claude Code CLI / Anthropic 凭据
# ============================================================
# 必填：火山引擎 Coding Plan API Token
ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token-here
# 火山引擎 Coding Plan API 网关
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# 主对话模型
ANTHROPIC_MODEL=deepseek-v4-flash
# 复杂任务模型
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
# 子代理模型
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
# 工作力度
CLAUDE_CODE_EFFORT_LEVEL=max
# API 超时（毫秒）
API_TIMEOUT_MS=3000000
# 关闭非必要流量
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ============================================================
# GitHub 集成（可选，用于自动推送）
# ============================================================
GITHUB_TOKEN=your-github-personal-access-token-here

# ============================================================
# 服务端口（仅影响宿主机端口映射；容器内仍为 8000）
# ============================================================
BACKEND_PORT=8000
POSTGRES_PORT=5432
